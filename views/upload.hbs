<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subir Avatar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-sm p-4" style="width: 100%; max-width: 450px;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4 text-primary fw-bold">Subir Imagen / Avatar</h3>

            <form id="uploadForm">
                <!-- Se elimina el campo de ID manual -->
                <div class="mb-3">
                    <label for="avatar" class="form-label">Selecciona una imagen:</label>
                    <input type="file" class="form-control" id="avatar" name="avatar" accept="image/*" required>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">Subir Imagen</button>
            </form>

            <div id="alertSuccess" class="alert alert-success mt-3 d-none"></div>
            <div id="alertError" class="alert alert-danger mt-3 d-none"></div>

            <div id="previewContainer" class="mt-3 text-center d-none">
                <h5>Imagen Actual:</h5>
                <img id="imgPreview" src="" class="img-thumbnail mt-2" style="max-height: 180px;">
            </div>
        </div>
    </div>

    <script>
        document.getElementById('uploadForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const fileInput = document.getElementById('avatar');
            const alertSuccess = document.getElementById('alertSuccess');
            const alertError = document.getElementById('alertError');
            const previewContainer = document.getElementById('previewContainer');
            const imgPreview = document.getElementById('imgPreview');

            alertSuccess.classList.add('d-none');
            alertError.classList.add('d-none');

            // 1. Obtener token del localStorage
            const token = localStorage.getItem('token');

            // 2. Si no hay token, requerir inicio de sesión
            if (!token) {
                alertError.textContent = 'Debes iniciar sesión para realizar esta acción.';
                alertError.classList.remove('d-none');
                return;
            }

            if (!fileInput.files[0]) {
                alertError.textContent = 'Por favor selecciona un archivo de imagen';
                alertError.classList.remove('d-none');
                return;
            }

            const formData = new FormData();
            formData.append('avatar', fileInput.files[0]);

            try {
                // Petición a la nueva ruta sin :id en la URL
                const response = await fetch('/api/usuarios/avatar', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    },
                    body: formData
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Error al subir la imagen');
                }

                alertSuccess.textContent = data.mensaje;
                alertSuccess.classList.remove('d-none');

                imgPreview.src = data.avatar;
                previewContainer.classList.remove('d-none');

            } catch (err) {
                alertError.textContent = err.message;
                alertError.classList.remove('d-none');
            }
        });
    </script>
</body>
</html>