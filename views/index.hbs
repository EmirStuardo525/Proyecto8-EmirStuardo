<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{titulo}}</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">{{titulo}}</a>
            <div id="authArea" class="ms-auto">
                <!-- Renderizado dinámico vía JavaScript -->
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <div class="container my-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Lista de Productos</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Nombre</th>
                                <th scope="col">Precio</th>
                                <th scope="col">Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each productos}}
                            <tr>
                                <th scope="row">{{this.id}}</th>
                                <td>{{this.nombre}}</td>
                                <td>${{this.precio}}</td>
                                <td>
                                    <span class="badge bg-secondary">{{this.stock}} uds</span>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const authArea = document.getElementById('authArea');
        const token = localStorage.getItem('token');

        if (token) {
            authArea.innerHTML = `
        <span class="text-white me-3">Sesión activa</span>
        <button onclick="logout()" class="btn btn-outline-danger btn-sm">Cerrar Sesión</button>
      `;
        } else {
            authArea.innerHTML = `
        <a href="/login" class="btn btn-outline-light btn-sm">Iniciar Sesión</a>
      `;
        }

        function logout() {
            localStorage.removeItem('token');
            window.location.reload();
        }
    </script>

</body>

</html>